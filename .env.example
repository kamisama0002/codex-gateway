# Generate a production value with: openssl rand -hex 32
CODEX_GATEWAY_CONFIG_SECRET=replace-with-a-stable-random-secret
# Self-contained Compose credentials. Generate both passwords independently with openssl rand -hex 32.
MYSQL_DATABASE=codex_gateway
MYSQL_USER=codex_gateway
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# External database mode only. Keep empty for self-contained Compose; percent-encode URL credentials.
DATABASE_URL=
# External production should use required or verify-identity. Bundled MySQL defaults to disabled TLS.
MYSQL_TLS_MODE=
# Required with verify-identity. This path must be readable inside Gateway and database CLI containers.
MYSQL_TLS_CA_FILE=
# DataOps exchanges one-time workbench tickets with Gateway over this server-only channel.
DATAOPS_BASE_URL=http://dataops-api:8888
DATAOPS_SSO_SHARED_SECRET=replace-with-a-different-shared-random-secret
DATAOPS_ALLOWED_ORIGINS=https://dataops.example.com
# Leave empty for deb.debian.org. In China use mirrors.aliyun.com or mirrors.tuna.tsinghua.edu.cn.
DEBIAN_MIRROR=
# Leave empty for registry.npmjs.org. In China use https://registry.npmmirror.com
NPM_REGISTRY=
# Leave empty for pypi.org. In China use https://mirrors.aliyun.com/pypi/simple
PYPI_INDEX_URL=
# Generate a production value with: openssl rand -hex 32
RUNTIME_MANAGER_SHARED_SECRET=replace-with-a-different-stable-random-secret
# On the first multi-node rollout this must equal the existing RUNTIME_MANAGER_SHARED_SECRET.
# Keep it stable afterward even when an individual node secret rotates.
RUNTIME_IDENTITY_SECRET=replace-with-the-existing-runtime-manager-secret
RUNTIME_MANAGER_DEFAULT_NODE_ID=node__default
RUNTIME_NODE_CAPACITY_CPU_MILLIS=16000
RUNTIME_NODE_CAPACITY_MEMORY_BYTES=68719476736
RUNTIME_NODE_MAX_RUNTIMES=30
RUNTIME_NODE_MINIMUM_FREE_DISK_BYTES=21474836480
RUNTIME_NODE_HEALTH_FRESHNESS_MS=30000
# Set to 1 only when Runtime Manager is reached over an explicitly isolated HTTP network.
RUNTIME_NODE_ALLOW_INSECURE_HTTP=0
WEB_COMMON_NETWORK_NAME=web-common
WEB_COMMON_NETWORK_SUBNET=10.1.249.0/24
RUNTIME_MANAGER_BASE_URL=http://agent-runtime-manager:8787
RUNTIME_MANAGER_DEFAULT_IMAGE_ALIAS=stable
RUNTIME_MANAGER_IMAGE=codex-runtime-manager:0.153.4
RUNTIME_MANAGER_IMAGE_ALIASES={"stable":{"image":"codex-agent-runtime:0.153.4","imageVersion":"0.153.4"}}
RUNTIME_MANAGER_NETWORK_NAME=runtime-manager
RUNTIME_MANAGER_NETWORK_SUBNET=10.1.250.0/24
RUNTIME_MANAGER_AGENT_NETWORK=agent-runtime
RUNTIME_MANAGER_AGENT_NETWORK_SUBNET=10.1.251.0/24
RUNTIME_MANAGER_AGENT_EGRESS_NETWORK=agent-egress
RUNTIME_MANAGER_AGENT_EGRESS_NETWORK_SUBNET=10.1.252.0/24
SEARCH_BACKEND_NETWORK_SUBNET=10.1.253.0/24
GATEWAY_DATABASE_NETWORK_SUBNET=10.1.254.0/24
# Official SearXNG multi-architecture image, pinned to the digest verified on 2026-09-07.
SEARXNG_IMAGE=searxng/searxng@sha256:55e1fa15a63ff04e79e213e6aa2837549877b0c6d60757cdb633ae9111cb5fea
SEARXNG_SECRET=replace-with-a-different-random-secret
SEARXNG_MEM_LIMIT=1g
SEARXNG_MEMSWAP_LIMIT=1g
SEARXNG_PIDS_LIMIT=256
SEARXNG_CPU_LIMIT=2.0
SEARCH_MCP_IMAGE=codex-search-mcp:0.153.4
SEARCH_MCP_MEM_LIMIT=256m
SEARCH_MCP_MEMSWAP_LIMIT=256m
SEARCH_MCP_PIDS_LIMIT=64
SEARCH_MCP_CPU_LIMIT=0.5
# Public URL registered with MCP OAuth providers. HTTPS is recommended outside local testing.
RUNTIME_MANAGER_MCP_OAUTH_CALLBACK_URL=https://agent.example.com/api/capabilities/mcp/oauth/callback
# Comma-separated exact HTTPS origins allowed to issue short-lived runtime credentials.
EXTERNAL_CREDENTIAL_ISSUER_ORIGINS=
RUNTIME_PROVIDER_PROXY_BASE_URL=http://codex-gateway:3000/api/internal/providers
RUNTIME_MANAGER_MEM_LIMIT=512m
RUNTIME_MANAGER_MEMSWAP_LIMIT=512m
RUNTIME_MANAGER_PIDS_LIMIT=128
RUNTIME_MANAGER_CPU_LIMIT=1.0
# Per-user Agent container caps. Changing these applies on the next Agent start/restart.
RUNTIME_AGENT_MEMORY=8g
RUNTIME_AGENT_CPUS=4
RUNTIME_AGENT_PIDS=1024
