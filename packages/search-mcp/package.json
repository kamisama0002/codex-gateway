{
  "name": "@codex-gateway/search-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js",
    "smoke": "node scripts/smoke.ts",
    "start": "node dist/server.js",
    "test": "vitest run --root ../.. packages/search-mcp/src/server.test.ts packages/search-mcp/src/url-policy.test.ts packages/search-mcp/src/compose.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  }
}
