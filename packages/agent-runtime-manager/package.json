{
  "name": "@codex-gateway/agent-runtime-manager",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./dist/auth.js"
    },
    "./docker-engine": {
      "types": "./src/docker-engine.ts",
      "import": "./dist/docker-engine.js"
    },
    "./lifecycle-service": {
      "types": "./src/lifecycle-service.ts",
      "import": "./dist/lifecycle-service.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && rimraf dist && esbuild src/contracts.ts src/auth.ts src/docker-engine.ts src/lifecycle-service.ts src/http-server.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:dockerode --external:zod",
    "start": "node dist/http-server.js",
    "test": "vitest run --root ../.. packages/agent-runtime-manager/src/lifecycle-service.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codex-gateway/agent-runtime-contracts": "workspace:*",
    "dockerode": "^4.0.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.44",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
